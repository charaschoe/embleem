# Environment variables for Embleem
# Copy this file to .env and fill in your actual values

# Unsplash API Access Key (server-side only, not exposed to client)
# Get your key from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Note: Do NOT use VITE_ prefix for sensitive keys as they will be exposed to the client
# Only use VITE_ for public configuration values that are safe to expose

# Supabase highscores (public browser configuration)
# These are safe to expose when Row Level Security policies only allow public select/insert.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
